<script src="https://unpkg.com/lucide@latest"></script>
<script>
  function normalizeCopyText(rawText) {
    return rawText
      .split(/\r?\n/)
      .map(function (line) { return line.replace(/\u00a0/g, ' ').trimEnd(); })
      .filter(function (line) { return line.trim().length > 0; })
      .join('\n');
  }

  document.addEventListener('DOMContentLoaded', function () {
    lucide.createIcons();

    function autoResize(textarea) {
      textarea.style.height = 'auto';
      const borderHeight = textarea.offsetHeight - textarea.clientHeight;
      textarea.style.height = textarea.scrollHeight + borderHeight + 'px';
    }

    document.querySelectorAll('.auto-textarea').forEach(autoResize);
    document.addEventListener('input', function (event) {
      if (event.target.classList.contains('auto-textarea')) autoResize(event.target);
    });
    window.addEventListener('resize', function () {
      document.querySelectorAll('.auto-textarea').forEach(autoResize);
    });

    const menuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');

    if (menuBtn && mobileMenu) {
      menuBtn.addEventListener('click', function () {
        const isOpen = !mobileMenu.classList.contains('hidden');
        mobileMenu.classList.toggle('hidden');
        menuBtn.setAttribute('aria-expanded', String(!isOpen));
      });
    }

    document.addEventListener('click', function (event) {
      const resetBtn = event.target.closest('.reset-prompt-btn');
      if (!resetBtn) return;

      const box = resetBtn.closest('.copy-prompt-box');
      const textarea = box && box.querySelector('textarea.copy-prompt-content');
      if (!textarea) return;

      textarea.value = textarea.defaultValue;
      autoResize(textarea);
    });

    document.addEventListener('click', async function (event) {
      const btn = event.target.closest('.copy-prompt-btn');
      if (!btn) return;

      const box = btn.closest('.copy-prompt-box');
      const content = box && box.querySelector('.copy-prompt-content');
      if (!content) return;

      const rawText = content.tagName === 'TEXTAREA' ? content.value : content.innerText;
      const text = normalizeCopyText(rawText);
      try {
        await navigator.clipboard.writeText(text);
        const icon = btn.querySelector('.copy-prompt-icon');
        if (icon) {
          icon.setAttribute('data-lucide', 'check');
          lucide.createIcons();
          setTimeout(function () {
            icon.setAttribute('data-lucide', 'copy');
            lucide.createIcons();
          }, 1500);
        }
      } catch (err) {
        console.error('복사 실패:', err);
      }
    });
  });
</script>
