<div class="copy-prompt-box relative rounded-xl border border-black/8 bg-house-green/90 text-sm leading-relaxed text-white/90 transition-shadow duration-200 focus-within:ring-2 focus-within:ring-green-accent focus-within:ring-offset-2 focus-within:ring-offset-white">
  <div class="flex justify-end gap-2 border-b border-white/10 px-4 pb-2 pt-4 sm:px-5">
    <button
      type="button"
      class="reset-prompt-btn inline-flex h-8 w-8 items-center justify-center rounded-lg border border-white/20 bg-white/10 text-white/90 transition-all duration-200 hover:border-green-light/50 hover:bg-white/20 hover:text-white active:scale-95"
      aria-label="원래 내용으로 되돌리기"
      title="원래 내용으로 되돌리기"
    >
      <i data-lucide="rotate-ccw" class="h-4 w-4"></i>
    </button>
    <button
      type="button"
      class="copy-prompt-btn inline-flex h-8 w-8 items-center justify-center rounded-lg border border-white/20 bg-white/10 text-white/90 transition-all duration-200 hover:border-green-light/50 hover:bg-white/20 hover:text-white active:scale-95"
      aria-label="텍스트 복사"
    >
      <i data-lucide="copy" class="copy-prompt-icon h-4 w-4"></i>
    </button>
  </div>
  <textarea
    class="copy-prompt-content auto-textarea block w-full resize-none overflow-hidden rounded-b-xl border-0 bg-transparent px-4 py-4 font-code text-[18px] leading-relaxed text-white/90 outline-none sm:px-5 sm:py-5"
    rows="1"
    spellcheck="false"
    aria-label="프롬프트 편집"
  ><%= text %></textarea>
</div>
